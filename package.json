{
  "name": "maperture",
  "author": "Stamen Design <info@stamen.com> (https://stamen.com)",
  "description": "Stamen's map compare tool",
  "version": "0.17.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stamen/maperture.git"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.js",
    "build-example": "yarn build && rm -rf example/dist && cp -r dist example/dist",
    "serve-example": "yarn build-example && sirv example --no-clear --port 5000",
    "format": "prettier --write .",
    "prepare": "husky install",
    "deploy": "yarn build && node scripts/deploy.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "gh-pages": "^4.0.0",
    "husky": "^7.0.0",
    "prettier": "^3.9.7",
    "prettier-plugin-svelte": "^4.1.1",
    "pretty-quick": "^4.2.2",
    "sirv-cli": "^1.0.0",
    "svelte": "^5.57.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@beyonk/svelte-mapbox": "^8.1.4",
    "@fortawesome/free-solid-svg-icons": "^6.1.1",
    "@googlemaps/js-api-loader": "^1.13.10",
    "@maptiler/sdk": "^3.0.1",
    "autoprefixer": "^10.4.14",
    "deep-equal": "^2.0.5",
    "hat": "^0.0.3",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.3",
    "lodash.isequal": "^4.5.0",
    "lodash.throttle": "^4.1.1",
    "mapbox-gl": "^3.10.0",
    "maplibre-gl": "^5.12.0",
    "postcss": "^8.4.23",
    "stamen-attribution": "github:stamen/stamen-attribution#v0.1.0",
    "svelte-fa": "^2.4.0",
    "tangram": "^0.21.1"
  },
  "main": "dist/bundle.js"
}
